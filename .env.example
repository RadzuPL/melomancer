# Copy to .env next to docker-compose.yml and fill in the first two values.

# Bot token from https://discord.com/developers/applications (Bot page). See docs/en/discord-bot.md
DISCORD_TOKEN=

# First administrator, created only when the database is empty. Minimum 10 characters.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# File ownership inside /data. Use the id of the user that should own the files on the host
# (Unraid: 99 and 100, most Linux desktops: 1000 and 1000).
PUID=1000
PGID=1000
TZ=Europe/Warsaw

# Optional tuning - the defaults are fine for most setups.
# YTDLP_ENABLED=true
# YTDLP_DAILY_LIMIT=50
# YTDLP_MIN_GAP_SECONDS=20
# YTDLP_ALLOWED_HOSTS=youtube.com,youtu.be,music.youtube.com,soundcloud.com,bandcamp.com
# MAX_UPLOAD_MB=300
# IDLE_LEAVE_MINUTES=30
# DEFAULT_VOLUME=0.4
# COOKIE_SECURE=auto
# SESSION_HOURS=168
# LOG_LEVEL=INFO
